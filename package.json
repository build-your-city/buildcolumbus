{
	"name": "build-columbus",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "npm run dev:columbus",
		"dev:columbus": "vite --config sites/columbus/vite.config.ts --port 3000",
		"dev:byc": "vite --config sites/build-your-city/vite.config.ts --port 3001",
		"build": "tsc --noEmit && npm run build:columbus && npm run build:byc",
		"build:columbus": "vite build --config sites/columbus/vite.config.ts",
		"build:byc": "vite build --config sites/build-your-city/vite.config.ts",
		"serve": "vite preview --config sites/columbus/vite.config.ts",
		"serve:byc": "vite preview --config sites/build-your-city/vite.config.ts",
		"test": "vitest run --passWithNoTests",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"sync-events": "node scripts/sync-events.mjs"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.132.0",
		"lucide-react": "^0.545.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.48",
		"@types/node": "^26.6.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^5.0.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.7.2",
		"vite": "^7.1.7",
		"vitest": "^5.0.5"
	}
}
